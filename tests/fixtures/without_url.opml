<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
  <head>
    <title>Mixed Outlines</title>
  </head>
  <body>
    <outline
        text="Valid Feed"
        title="Valid Feed"
        type="rss"
        xmlUrl="https://valid.com/feed.xml"
        htmlUrl="https://valid.com"
      />
    <outline
        text="Category Without URL"
        title="Category Without URL"
        type="category"
      />
    <outline
        text="Another Valid Feed"
        title="Another Valid Feed"
        type="rss"
        xmlUrl="https://another.com/feed.xml"
      />
  </body>
</opml>
